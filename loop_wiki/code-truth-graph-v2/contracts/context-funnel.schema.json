{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bettor-arena/code-truth-graph-v2/context-funnel.schema.json",
  "title": "Exact-subject compiler truth context funnel request",
  "type": "object",
  "required": ["schema", "subject", "language", "targets", "required_lenses", "limits"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "bettor-arena/context-funnel-request/v1"},
    "subject": {
      "type": "object",
      "required": ["repository", "commit", "tree"],
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "language": {"type": "string", "minLength": 1},
    "targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "required_lenses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["source", "grepai", "scip-lsp", "tree-sitter", "test", "runtime"]}
    },
    "limits": {
      "type": "object",
      "required": ["max_depth", "max_nodes", "max_paths", "max_output_bytes"],
      "additionalProperties": false,
      "properties": {
        "max_depth": {"type": "integer", "minimum": 0, "maximum": 8},
        "max_nodes": {"type": "integer", "minimum": 1, "maximum": 512},
        "max_paths": {"type": "integer", "minimum": 1, "maximum": 512},
        "max_output_bytes": {"type": "integer", "minimum": 512, "maximum": 1048576}
      }
    }
  }
}
