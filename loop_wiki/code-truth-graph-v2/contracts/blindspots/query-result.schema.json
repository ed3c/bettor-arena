{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bettor-arena/code-truth-graph-v2/blindspots-query-result.schema.json",
  "title": "Blindspots query result",
  "type": "object",
  "required": ["schema", "subject", "query", "verdict", "reason", "coverage_complete", "missing_or_unfresh_lenses", "support_ids", "deny_ids", "candidate_ids", "absence_proof"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "bettor-arena/blindspots-query-result/v1"},
    "subject": {"type": "object"},
    "query": {"type": "object"},
    "verdict": {"enum": ["FOUND", "CONTESTED", "NO_FLOW", "UNKNOWN"]},
    "reason": {"type": "string", "minLength": 1},
    "coverage_complete": {"type": "boolean"},
    "missing_or_unfresh_lenses": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "support_ids": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
    "deny_ids": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
    "candidate_ids": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
    "absence_proof": {"enum": ["NONE", "COMPLETE_REQUIRED_LENSES"]}
  }
}
