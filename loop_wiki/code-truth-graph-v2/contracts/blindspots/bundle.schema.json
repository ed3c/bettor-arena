{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bettor-arena/code-truth-graph-v2/blindspots-bundle.schema.json",
  "title": "Blindspots observation bundle",
  "type": "object",
  "required": ["schema", "subject", "coverage", "observations"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "bettor-arena/blindspots-observation-bundle/v1"},
    "subject": {
      "type": "object",
      "required": ["repository", "commit", "tree"],
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lens", "language", "state", "freshness", "tool_identity"],
        "additionalProperties": false,
        "properties": {
          "lens": {"enum": ["source", "grepai", "scip-lsp", "tree-sitter", "test", "runtime"]},
          "language": {"type": "string", "minLength": 1},
          "state": {"enum": ["COMPLETE", "PARTIAL", "UNSUPPORTED", "ABSENT"]},
          "freshness": {"enum": ["FRESH", "STALE", "UNKNOWN"]},
          "tool_identity": {"type": "string", "minLength": 1}
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "source_sha256", "language", "lens", "tool_identity", "source", "target", "relation", "readback"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "language": {"type": "string", "minLength": 1},
          "lens": {"enum": ["source", "grepai", "scip-lsp", "tree-sitter", "test", "runtime"]},
          "tool_identity": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "relation": {"enum": ["SUPPORTS_FLOW", "DENIES_FLOW", "CANDIDATE"]},
          "readback": {"enum": ["CONFIRMED", "MISSING", "DRIFTED", "NOT_REQUIRED"]},
          "span": {"type": "string", "maxLength": 512},
          "note": {"type": "string", "maxLength": 2048}
        }
      }
    }
  }
}
