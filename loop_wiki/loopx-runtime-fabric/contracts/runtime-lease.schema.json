{
  "$id": "https://ed3c.dev/bettor-arena/loopx/runtime-lease/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One owner, an expiry, and the state revision it was granted at. Two Workers on one lease is not a race to tune; it is two processes believing they own one directory.",
  "properties": {
    "expected_state_revision": {
      "minimum": 0,
      "type": "integer"
    },
    "expires_at": {
      "minLength": 1,
      "type": "string"
    },
    "granted_at": {
      "minLength": 1,
      "type": "string"
    },
    "lease_id": {
      "minLength": 1,
      "type": "string"
    },
    "owner": {
      "minLength": 1,
      "type": "string"
    },
    "provider_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "loopx/runtime-lease/v1"
    },
    "subject": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "tree": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit",
        "tree",
        "task_id"
      ],
      "type": "object"
    },
    "workspace_root": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "lease_id",
    "owner",
    "subject",
    "granted_at",
    "expires_at",
    "expected_state_revision",
    "workspace_root",
    "provider_id"
  ],
  "title": "LoopX Runtime Lease v1",
  "type": "object"
}
