{
  "$id": "https://bettor-arena.invalid/loopx/skill-evolution/case-set/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Cases with their expected answers. Only the whitelisted fields ever reach a runner.",
  "properties": {
    "cases": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "minLength": 1,
            "type": "string"
          },
          "expected": {
            "description": "Never reaches a runner: the payload is built from a whitelist that omits it, and the built payload is scanned for this string.",
            "minLength": 1,
            "type": "string"
          },
          "hard_gate_ids": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "inputs": {
            "type": "object"
          },
          "kind": {
            "enum": [
              "DEV",
              "HOLDOUT",
              "MUTATION"
            ]
          },
          "prompt": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "case_id",
          "expected",
          "hard_gate_ids",
          "inputs",
          "kind",
          "prompt"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "kind": {
      "enum": [
        "DEV",
        "HOLDOUT",
        "MUTATION"
      ]
    },
    "schema_version": {
      "const": "loopx/skill-evolution-case-set/v1"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "cases"
  ],
  "title": "Skill evolution case set",
  "type": "object"
}
