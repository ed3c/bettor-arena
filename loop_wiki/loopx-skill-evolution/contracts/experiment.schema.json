{
  "$id": "https://bettor-arena.invalid/loopx/skill-evolution/experiment/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Three arms under one execution contract, with a sealed holdout and a mutation suite sealed before the run.",
  "properties": {
    "advisory_judges": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "arms": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "arm": {
            "enum": [
              "current",
              "candidate",
              "baseline"
            ]
          },
          "content_bytes": {
            "description": "Empty for the baseline: it is the no-skill control, and giving it content removes the only arm that could show the Skill is not needed.",
            "type": "string"
          },
          "content_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "arm",
          "content_bytes",
          "content_digest",
          "notes"
        ],
        "type": "object"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    },
    "dev_case_set_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "execution_contract": {
      "additionalProperties": false,
      "description": "Declared once and shared by every arm. Arms carry no execution fields of their own, so a model or tool differing between them is not expressible.",
      "properties": {
        "context_policy": {
          "minLength": 1,
          "type": "string"
        },
        "host_id": {
          "minLength": 1,
          "type": "string"
        },
        "max_context_tokens": {
          "minimum": 1,
          "type": "integer"
        },
        "model_id": {
          "minLength": 1,
          "type": "string"
        },
        "ordering": {
          "enum": [
            "INTERLEAVED",
            "RANDOMIZED_FIXED_SEED"
          ]
        },
        "provider_id": {
          "minLength": 1,
          "type": "string"
        },
        "repetitions": {
          "description": "One run of each arm cannot separate a better prompt from a luckier sample.",
          "minimum": 3,
          "type": "integer"
        },
        "stopping_rule": {
          "description": "Stopping when the numbers look good turns a null result into a win.",
          "enum": [
            "FIXED_REPETITIONS"
          ]
        },
        "tools_allowlist": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "context_policy",
        "host_id",
        "max_context_tokens",
        "model_id",
        "ordering",
        "provider_id",
        "repetitions",
        "stopping_rule",
        "tools_allowlist"
      ],
      "type": "object"
    },
    "experiment_id": {
      "minLength": 1,
      "type": "string"
    },
    "hard_gates": {
      "description": "Deterministic and non-compensatory. Disjoint from advisory_judges.",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "mutation_suite": {
      "additionalProperties": false,
      "properties": {
        "case_count": {
          "minimum": 1,
          "type": "integer"
        },
        "derived_from": {
          "description": "A suite derived from the candidate's observed failures tests the failures it was written from.",
          "enum": [
            "TASK_SPECIFICATION",
            "PRIOR_INCIDENTS"
          ]
        },
        "sealed_at": {
          "type": "string"
        },
        "suite_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "case_count",
        "derived_from",
        "sealed_at",
        "suite_digest"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "loopx/skill-evolution-experiment/v1"
    },
    "sealed_holdout": {
      "additionalProperties": false,
      "properties": {
        "case_count": {
          "minimum": 1,
          "type": "integer"
        },
        "reveal_authority": {
          "const": "GRADER_ONLY"
        },
        "seal": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "sealed_at": {
          "type": "string"
        }
      },
      "required": [
        "case_count",
        "reveal_authority",
        "seal",
        "sealed_at"
      ],
      "type": "object"
    },
    "subject": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "ref_kind": {
          "const": "IMMUTABLE_RELEASE"
        },
        "repository": {
          "minLength": 1,
          "type": "string"
        },
        "skill_id": {
          "minLength": 1,
          "type": "string"
        },
        "skill_release": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "commit",
        "ref_kind",
        "repository",
        "skill_id",
        "skill_release"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "experiment_id",
    "subject",
    "execution_contract",
    "arms",
    "dev_case_set_digest",
    "mutation_suite",
    "sealed_holdout",
    "hard_gates",
    "advisory_judges"
  ],
  "title": "Skill evolution experiment contract",
  "type": "object"
}
