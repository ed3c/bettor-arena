{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/bettor-arena/loop_wiki/capability-workspace-control-plane/contracts/kaw-route-proposal.schema.json",
  "title": "Bettor capability workspace envelope for one exact KAW route proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "capabilityId", "proposal", "subjectAdmission", "mode"],
  "properties": {
    "schema": {"const": "bettor.capability-workspace-envelope/v1"},
    "capabilityId": {"const": "orchestrate.work"},
    "mode": {"enum": ["CONTRACT_ONLY", "FIXTURE_REFERENCE"]},
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "caller", "intent", "routeClass", "destinationOwner", "evidenceCeiling", "exactSubjects"],
      "properties": {
        "requestId": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$"},
        "caller": {"$ref": "#/$defs/authority"},
        "intent": {"type": "string", "minLength": 1, "maxLength": 1024},
        "routeClass": {"const": "ORCHESTRATE_WORK"},
        "destinationOwner": {
          "const": {"kind": "ORCHESTRATOR", "ownerId": "bettor-arena"}
        },
        "evidenceCeiling": {"enum": ["SOURCE_ONLY", "TECHNICAL"]},
        "exactSubjects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/expectation"}
        }
      }
    },
    "subjectAdmission": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/admission"}
    }
  },
  "$defs": {
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ownerId"],
      "properties": {
        "kind": {
          "enum": ["SOURCE_PROVIDER", "GITHUB", "DOMAIN_REPOSITORY", "METHOD_REPOSITORY", "QUALIFIER", "EXPERIMENT_OWNER", "RUNTIME_OWNER", "ORCHESTRATOR", "USER", "EXTERNAL"]
        },
        "ownerId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"}
      }
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logicalId", "kind"],
      "properties": {
        "logicalId": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$"},
        "kind": {
          "enum": ["SOURCE", "CLAIM", "REQUIREMENT", "CAPABILITY", "TECHNOLOGY_DECISION", "SKILL_CANDIDATE", "SKILL", "WORK_ITEM", "IMPLEMENTATION", "EVIDENCE", "EXPERIMENT", "OUTCOME", "PROMPT", "DOCUMENT", "OTHER"]
        }
      }
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "expectedVersion": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "expectedDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
      },
      "anyOf": [
        {"required": ["expectedVersion"]},
        {"required": ["expectedDigest"]}
      ]
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "version", "digest", "visibility", "dataClass", "canonicalAuthority"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "version": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "visibility": {"const": "PUBLIC"},
        "dataClass": {"const": "PUBLIC"},
        "canonicalAuthority": {"$ref": "#/$defs/authority"}
      }
    }
  }
}
