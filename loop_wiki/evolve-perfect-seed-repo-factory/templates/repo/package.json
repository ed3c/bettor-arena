{
  "name": "perfect-seed-generated-repo",
  "private": true,
  "type": "module",
  "scripts": {
    "lineage:minimum": "bun run scripts/check_minimum_lineage.ts",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "quality:fast": "bun run lineage:minimum && bun run format:check && bun run lint && bun run typecheck",
    "plan": "bun run scripts/plan.ts",
    "test": "bun test tests/operator.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.3.11",
    "eslint": "10.8.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  }
}
