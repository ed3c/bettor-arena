{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "perfect-seed-architecture-graph@1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "graph_id",
    "graph_kind",
    "scope",
    "claim_boundary",
    "nodes",
    "edges",
    "blind_spot_policy"
  ],
  "properties": {
    "schema_version": { "const": "perfect-seed-architecture-graph@1.0.0" },
    "graph_id": { "type": "string", "minLength": 1 },
    "graph_kind": { "enum": ["intended", "observed"] },
    "scope": { "type": "string", "minLength": 1 },
    "claim_boundary": { "type": "string", "minLength": 1 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "kind", "base", "owner_paths", "role"],
        "properties": {
          "node_id": { "type": "string", "pattern": "^N[0-9]{2}-[a-z0-9-]+$" },
          "kind": {
            "enum": [
              "input",
              "document",
              "data",
              "registry",
              "git",
              "skill",
              "projection",
              "gate",
              "attestation",
              "human",
              "script"
            ]
          },
          "base": { "type": "integer", "minimum": 1, "maximum": 8 },
          "owner_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["edge_id", "from", "to", "relation", "required", "oracle_id"],
        "properties": {
          "edge_id": { "type": "string", "pattern": "^E[0-9]{2}$" },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "relation": {
            "enum": [
              "reduces",
              "binds",
              "verifies",
              "defines",
              "constrains",
              "governs",
              "materializes",
              "authorizes",
              "calls",
              "projects",
              "compares",
              "gates",
              "informs",
              "indexes",
              "proposes"
            ]
          },
          "required": { "type": "boolean" },
          "oracle_id": { "type": ["string", "null"] }
        }
      }
    },
    "blind_spot_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opaque_edges_must_be_reported",
        "absence_requires_enumerated_scan",
        "retrieval_scores_are_candidates",
        "universal_perception_claim_forbidden"
      ],
      "properties": {
        "opaque_edges_must_be_reported": { "const": true },
        "absence_requires_enumerated_scan": { "const": true },
        "retrieval_scores_are_candidates": { "const": true },
        "universal_perception_claim_forbidden": { "const": true }
      }
    }
  }
}
