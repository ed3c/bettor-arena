{
  "$id": "https://bettor-arena.invalid/loopx/foldback/candidate-bundle/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Proposed knowledge patches awaiting Human Admit. Never a knowledge write.",
  "properties": {
    "admit_required": {
      "const": true
    },
    "after": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "ref_kind": {
          "const": "IMMUTABLE_COMMIT"
        },
        "repository": {
          "minLength": 1,
          "type": "string"
        },
        "tree": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit",
        "tree",
        "ref_kind"
      ],
      "type": "object"
    },
    "authority": {
      "const": "PROPOSES"
    },
    "before": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "ref_kind": {
          "const": "IMMUTABLE_COMMIT"
        },
        "repository": {
          "minLength": 1,
          "type": "string"
        },
        "tree": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit",
        "tree",
        "ref_kind"
      ],
      "type": "object"
    },
    "bundle_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "candidates_for_review": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "located": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "canonical_key": {
            "minLength": 1,
            "type": "string"
          },
          "match_reason": {
            "enum": [
              "EXPLICIT_ANCHOR",
              "DECLARED_SYMBOL",
              "SEMANTIC_SIMILARITY"
            ]
          },
          "matched_anchor_ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "matched_symbols": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "patchable": {
            "type": "boolean"
          },
          "similarity": {
            "type": "number"
          },
          "state": {
            "enum": [
              "AFFECTED",
              "CANDIDATE_FOR_REVIEW"
            ]
          }
        },
        "required": [
          "canonical_key",
          "match_reason",
          "matched_anchor_ids",
          "matched_symbols",
          "patchable",
          "similarity",
          "state"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "patches": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "loopx/foldback-candidate-bundle/v1"
    },
    "state": {
      "const": "CANDIDATE"
    }
  },
  "required": [
    "schema_version",
    "before",
    "after",
    "located",
    "patches",
    "candidates_for_review",
    "state",
    "admit_required",
    "authority",
    "bundle_digest"
  ],
  "title": "Fold-back candidate bundle",
  "type": "object"
}
