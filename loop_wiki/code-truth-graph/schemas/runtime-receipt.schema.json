{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Invariant Reach Runtime Receipt",
  "type": "object",
  "required": ["schema_version", "run_id", "environment_class", "authority"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": ["string", "null"]},
    "environment_class": {"enum": ["synthetic", "sandbox", "staging_real", "real_device", "production"]},
    "authority": {"type": "string"},
    "observed_nodes": {"type": "array", "items": {"type": "object"}},
    "observed_edges": {"type": "array", "items": {"type": "object", "required": ["source", "target", "kind"]}},
    "observations": {"type": "array", "items": {"type": "object", "required": ["summary"]}},
    "invariant_events": {"type": "array", "items": {"type": "object", "required": ["invariant_id", "action", "reach", "evidence_ids"]}}
  },
  "additionalProperties": true
}
