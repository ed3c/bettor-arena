{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bettor-arena-ctg-control@1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "commit", "run_id", "status", "baseline", "input_classifications", "produced_artifacts", "proof_digest", "runs", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "bettor-arena-ctg-control@1.0.0"},
    "commit": {"type": "string", "minLength": 40},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["passed", "failed"]},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit", "canonical_projection", "repeat_count"],
      "properties": {
        "exit": {"enum": [0, 2, 64]},
        "canonical_projection": {"type": "string"},
        "repeat_count": {"type": "integer", "minimum": 3}
      }
    },
    "input_classifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_ref", "classification", "exit", "projection"],
        "properties": {
          "artifact_ref": {"type": "string"},
          "classification": {"enum": ["required", "optional-consumed", "unused", "unprobeable"]},
          "exit": {"enum": [0, 2, 64]},
          "projection": {"type": "string"}
        }
      }
    },
    "produced_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "proof_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runs": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/run"}},
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "id", "cwd", "exit", "stdout", "stderr"],
      "properties": {
        "seq": {"type": "integer", "minimum": 1},
        "id": {"type": "string"},
        "cwd": {"enum": ["repo-root", "disposable-worktree"]},
        "exit": {"enum": [0, 2, 64]},
        "stdout": {"$ref": "#/$defs/stream"},
        "stderr": {"$ref": "#/$defs/stream"}
      }
    }
  }
}
