{
  "$id": "https://bettor-arena.invalid/loopx/lsp-pool/query-request/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A query bound to an exact server pin and an exact workspace subject.",
  "properties": {
    "kind": {
      "enum": [
        "DEFINITION",
        "DIAGNOSTICS",
        "REFERENCES",
        "SYMBOLS"
      ]
    },
    "language": {
      "minLength": 1,
      "type": "string"
    },
    "path": {
      "minLength": 1,
      "type": "string"
    },
    "request_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "loopx/lsp-pool-query-request/v1"
    },
    "server": {
      "additionalProperties": false,
      "properties": {
        "config_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "languages": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "multi_root": {
          "description": "Whether one process may serve several workspaces is a property of the server protocol, not a configuration preference.",
          "type": "boolean"
        },
        "server_id": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "config_digest",
        "languages",
        "multi_root",
        "server_id",
        "version"
      ],
      "type": "object"
    },
    "workspace": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "lease_id": {
          "minLength": 1,
          "type": "string"
        },
        "repository": {
          "minLength": 1,
          "type": "string"
        },
        "root": {
          "minLength": 1,
          "type": "string"
        },
        "tree": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "workspace_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "commit",
        "lease_id",
        "repository",
        "root",
        "tree",
        "workspace_id"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "kind",
    "path",
    "language",
    "server",
    "workspace"
  ],
  "title": "LSP pool query request",
  "type": "object"
}
