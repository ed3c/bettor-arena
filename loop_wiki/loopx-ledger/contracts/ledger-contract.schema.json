{
  "$id": "https://github.com/ed3c/bettor-arena/loop_wiki/loopx-ledger/contracts/ledger-contract.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "commands": {
      "items": {
        "$ref": "../../loopx-kernel/contracts/command.schema.json"
      },
      "type": "array"
    },
    "contract_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "gate_definitions": {
      "items": {
        "$ref": "../../loopx-kernel/contracts/gate-definition.schema.json"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "initial_state": {
      "$ref": "../../loopx-kernel/contracts/task-state.schema.json"
    },
    "schema_version": {
      "const": "loopx/ledger-contract/v1"
    },
    "subject": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "repository": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "type": "string"
        },
        "task_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "type": "string"
        },
        "tree": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit",
        "tree",
        "task_id"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "subject",
    "gate_definitions",
    "commands",
    "initial_state",
    "contract_digest"
  ],
  "title": "loopx/ledger-contract/v1",
  "type": "object"
}
