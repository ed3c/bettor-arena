{
  "$id": "https://github.com/ed3c/bettor-arena/loop_wiki/loopx-kernel/contracts/command.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "type": "string"
        },
        "class": {
          "enum": [
            "STRATEGY",
            "AGENT",
            "HUMAN_OPERATOR"
          ]
        }
      },
      "required": [
        "actor_id",
        "class"
      ],
      "type": "object"
    },
    "command_id": {
      "type": "string"
    },
    "expected_state_revision": {
      "minimum": 0,
      "type": "integer"
    },
    "kind": {
      "enum": [
        "INITIALIZE_TASK",
        "DISPATCH_TODO",
        "REQUEST_RETRY",
        "REQUEST_HITL",
        "CANCEL_TASK",
        "SUBMIT_HUMAN_DECISION"
      ]
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "human_decision": {
          "type": [
            "object",
            "null"
          ]
        },
        "reason_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "additionalProperties": false,
              "properties": {
                "artifact_id": {
                  "type": "string"
                },
                "bytes": {
                  "minimum": 0,
                  "type": "integer"
                },
                "digest": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "media_type": {
                  "type": "string"
                },
                "path": {
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
                  "type": "string"
                },
                "producer": {
                  "type": "string"
                }
              },
              "required": [
                "artifact_id",
                "kind",
                "path",
                "digest",
                "bytes",
                "media_type",
                "producer"
              ],
              "type": "object"
            }
          ]
        },
        "request_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "additionalProperties": false,
              "properties": {
                "artifact_id": {
                  "type": "string"
                },
                "bytes": {
                  "minimum": 0,
                  "type": "integer"
                },
                "digest": {
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "media_type": {
                  "type": "string"
                },
                "path": {
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
                  "type": "string"
                },
                "producer": {
                  "type": "string"
                }
              },
              "required": [
                "artifact_id",
                "kind",
                "path",
                "digest",
                "bytes",
                "media_type",
                "producer"
              ],
              "type": "object"
            }
          ]
        },
        "todo_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "todo_id",
        "request_ref",
        "reason_ref",
        "human_decision"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "loopx/command/v1"
    },
    "subject": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "repository": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "type": "string"
        },
        "task_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "type": "string"
        },
        "tree": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit",
        "tree",
        "task_id"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "command_id",
    "subject",
    "expected_state_revision",
    "kind",
    "actor",
    "payload"
  ],
  "title": "loopx/command/v1",
  "type": "object"
}
