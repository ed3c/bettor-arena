{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "technical-equivalence-adapter-receipt@1.2.0",
  "type": "object",
  "required": [
    "schema_version",
    "adapter_id",
    "source_peer",
    "source_commit",
    "source_files",
    "top_level_dependencies",
    "adapter_execution_policy_digest",
    "candidate_contract_digest",
    "execution_mirror",
    "research_request_digest",
    "status",
    "invocations",
    "adapter_receipt_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "technical-equivalence-adapter-receipt@1.2.0"
    },
    "status": {"enum": ["passed", "failed"]},
    "adapter_execution_policy_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "candidate_contract_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "execution_mirror": {
      "type": "object",
      "required": [
        "mirror_root",
        "side_effect_root",
        "redirected_exports",
        "redirect_targets",
        "mirror_files",
        "dependencies",
        "execution_mirror_digest"
      ],
      "properties": {
        "mirror_root": {"type": "string", "minLength": 1},
        "side_effect_root": {"type": "string", "minLength": 1},
        "redirected_exports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "redirect_targets": {"type": "object", "minProperties": 1},
        "mirror_files": {"type": "object", "minProperties": 1},
        "dependencies": {"type": "string", "minLength": 1},
        "execution_mirror_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "invocations": {"type": "array", "minItems": 1},
    "adapter_receipt_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
