{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "technical-equivalence-research-request@1.1.0",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "upstream_request_digest",
    "provider",
    "adapter_id",
    "max_gap_topics",
    "candidate_contract",
    "prompt",
    "prompt_digest",
    "research_request_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "technical-equivalence-research-request@1.1.0"
    },
    "max_gap_topics": {"const": 6},
    "candidate_contract": {
      "type": "object",
      "required": ["version", "digest"],
      "properties": {
        "version": {
          "const": "technical-equivalence-candidate-contract@1.0.0"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "prompt": {"type": "string", "minLength": 1}
  }
}
