{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "technical-equivalence-research-result@1.1.0",
  "type": "object",
  "required": [
    "schema_version",
    "upstream_research_request_digest",
    "candidate_contract_digest",
    "provider",
    "raw_markdown",
    "candidates",
    "research_result_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "technical-equivalence-research-result@1.1.0"
    },
    "candidate_contract_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "raw_markdown": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "candidate_id",
              "claim",
              "source_urls",
              "falsification_conditions",
              "inference"
            ],
            "properties": {
              "candidate_id": {"type": "string", "minLength": 1},
              "claim": {"type": "string", "minLength": 1},
              "source_urls": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "pattern": "^https://"}
              },
              "falsification_conditions": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              },
              "inference": {"const": true}
            }
          },
          {
            "type": "object",
            "required": [
              "candidate_id",
              "claim",
              "repo_url",
              "commit",
              "spdx",
              "source_urls",
              "code_anchors",
              "inference"
            ],
            "properties": {
              "candidate_id": {"type": "string", "minLength": 1},
              "claim": {"type": "string", "minLength": 1},
              "repo_url": {"type": "string", "pattern": "^https://"},
              "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "spdx": {"type": "string", "minLength": 1},
              "source_urls": {"type": "array", "minItems": 1},
              "code_anchors": {"type": "array"},
              "inference": {"const": false}
            }
          }
        ]
      }
    }
  }
}
