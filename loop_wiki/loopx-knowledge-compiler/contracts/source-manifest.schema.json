{
  "$id": "https://bettor-arena.invalid/loopx/knowledge/source-manifest/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Every source a compile may cite, with the locator that makes it checkable.",
  "properties": {
    "compiler_identity": {
      "minLength": 1,
      "type": "string"
    },
    "notes_subject": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "ref": {
          "minLength": 1,
          "type": "string"
        },
        "ref_kind": {
          "const": "IMMUTABLE_COMMIT"
        },
        "repository": {
          "minLength": 1,
          "type": "string"
        },
        "tree": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit",
        "tree",
        "ref",
        "ref_kind"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "loopx/knowledge-source-manifest/v1"
    },
    "sources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "byte_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": [
              "string",
              "null"
            ]
          },
          "declared_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "dependency_key": {
            "description": "Sources sharing this key are one piece of evidence, not several.",
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "enum": [
              "NOTE",
              "TRANSCRIPT",
              "DIAGRAM",
              "SOURCE_CODE",
              "EXTERNAL_DOC"
            ]
          },
          "locator": {
            "pattern": "^[A-Za-z0-9._\\-/]+#L\\d+(-L\\d+)?$",
            "type": [
              "string",
              "null"
            ]
          },
          "recorded_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "byte_digest",
          "declared_version",
          "dependency_key",
          "kind",
          "locator",
          "recorded_at",
          "source_id"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "notes_subject",
    "sources",
    "compiler_identity"
  ],
  "title": "Knowledge compiler source manifest",
  "type": "object"
}
