{
  "$id": "https://bettor-arena.invalid/loopx/knowledge/assertion-graph/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Claims with their kind, verification state and recorded contradictions.",
  "properties": {
    "assertions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "assertion_id": {
            "minLength": 1,
            "type": "string"
          },
          "execution_receipt": {
            "additionalProperties": false,
            "properties": {
              "command": {
                "minLength": 1,
                "type": "string"
              },
              "exit_code": {
                "type": "integer"
              },
              "output_digest": {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "command",
              "exit_code",
              "output_digest"
            ],
            "type": [
              "object",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "SOURCE_STATEMENT",
              "INFERENCE",
              "HYPOTHESIS",
              "NORM"
            ]
          },
          "resolution": {
            "description": "Must be null on an UNKNOWN; an unknown with an answer was filled from outside the sources.",
            "type": [
              "string",
              "null"
            ]
          },
          "source_ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "text": {
            "minLength": 1,
            "type": "string"
          },
          "verification_state": {
            "enum": [
              "UNVERIFIED",
              "CORROBORATED",
              "VERIFIED_BY_EXECUTION",
              "ADMITTED_BY_HUMAN",
              "CONTRADICTED",
              "UNKNOWN"
            ]
          }
        },
        "required": [
          "assertion_id",
          "execution_receipt",
          "kind",
          "resolution",
          "source_ids",
          "text",
          "verification_state"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "contradictions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "assertion_ids": {
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "type": "array"
          },
          "contradiction_id": {
            "minLength": 1,
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "state": {
            "enum": [
              "OPEN",
              "ESCALATED_TO_HUMAN"
            ]
          }
        },
        "required": [
          "assertion_ids",
          "contradiction_id",
          "note",
          "state"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "notes_subject": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "ref": {
          "minLength": 1,
          "type": "string"
        },
        "ref_kind": {
          "const": "IMMUTABLE_COMMIT"
        },
        "repository": {
          "minLength": 1,
          "type": "string"
        },
        "tree": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit",
        "tree",
        "ref",
        "ref_kind"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "loopx/knowledge-assertion-graph/v1"
    }
  },
  "required": [
    "schema_version",
    "notes_subject",
    "assertions",
    "contradictions"
  ],
  "title": "Knowledge compiler assertion graph",
  "type": "object"
}
