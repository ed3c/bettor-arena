{
  "$id": "https://bettor-arena.invalid/loopx/knowledge/card-graph/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Cards keyed by content, so a rerun on the same sources reproduces the same ids.",
  "properties": {
    "cards": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "assertion_ids": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "canonical_key": {
            "minLength": 1,
            "type": "string"
          },
          "card_id": {
            "pattern": "^card-[0-9a-f]{16}$",
            "type": "string"
          },
          "kind": {
            "minLength": 1,
            "type": "string"
          },
          "links": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "SUPPORTS",
                    "CONTRADICTS",
                    "REFINES",
                    "DEPENDS_ON"
                  ]
                },
                "target": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "target"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "title": {
            "minLength": 1,
            "type": "string"
          },
          "unknowns": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "verification_state": {
            "enum": [
              "UNVERIFIED",
              "CORROBORATED",
              "VERIFIED_BY_EXECUTION",
              "PARTIALLY_UNKNOWN",
              "CONTRADICTED"
            ]
          }
        },
        "required": [
          "assertion_ids",
          "canonical_key",
          "card_id",
          "kind",
          "links",
          "title",
          "unknowns",
          "verification_state"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "notes_subject": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "ref": {
          "minLength": 1,
          "type": "string"
        },
        "ref_kind": {
          "const": "IMMUTABLE_COMMIT"
        },
        "repository": {
          "minLength": 1,
          "type": "string"
        },
        "tree": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit",
        "tree",
        "ref",
        "ref_kind"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "loopx/knowledge-card-graph/v1"
    }
  },
  "required": [
    "schema_version",
    "notes_subject",
    "cards"
  ],
  "title": "Knowledge card graph",
  "type": "object"
}
