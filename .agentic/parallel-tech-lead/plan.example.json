  "_meta": {
    "why_this_slice": "Two gates that do not read each other's files, plus the index that lists them. It is the smallest shape in this repository that is genuinely path-disjoint and still needs a convergence owner, which is what makes it a fan-out rather than three unrelated tasks.",
    "why_not_a_tournament": "There is one right answer to 'does this gate hold', so several differentiated implementations would measure nothing. TOURNAMENT is for questions with more than one defensible shape."
  },
  "base": {
    "branch": "main",
    "commit_sha": "254f2dedad82eca66ed825833827db3f7e33606d",
