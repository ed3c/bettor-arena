{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://ed3c.github.io/bettor-arena/contracts/knowledge-provider-evals/participant.schema.json","title":"Knowledge Provider Eval Participant v1","type":"object","additionalProperties":false,"required":["id","kind","families","identity_digest","human_admit_required"],"properties":{"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{2,127}$"},"kind":{"enum":["control","provider"]},"families":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["symbol","semantic","graph","memory"]}},"identity_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"manifest_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"control_contract":{"type":"object","minProperties":1},"human_admit_required":{"const":true}},"allOf":[{"if":{"properties":{"kind":{"const":"provider"}}},"then":{"required":["manifest_digest"]}},{"if":{"properties":{"kind":{"const":"control"}}},"then":{"required":["control_contract"]}}]}
