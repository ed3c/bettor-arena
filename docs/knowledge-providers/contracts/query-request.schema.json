{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ed3c.github.io/bettor-arena/contracts/knowledge-provider-query-request.v1.schema.json",
  "title": "Knowledge Provider Query Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "subject",
    "provider",
    "capability",
    "query",
    "query_digest",
    "constraints"
  ],
  "properties": {
    "schema_version": {
      "const": "knowledge-provider-query-request/v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "tree"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "manifest_digest"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "manifest_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "capability": {
      "type": "string"
    },
    "query": {
      "type": "object"
    },
    "query_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_only",
        "require_fresh_index",
        "max_results",
        "max_bytes"
      ],
      "properties": {
        "read_only": {
          "const": true
        },
        "require_fresh_index": {
          "type": "boolean"
        },
        "max_results": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "path_scope": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
