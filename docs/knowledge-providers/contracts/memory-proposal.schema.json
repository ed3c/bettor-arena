{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ed3c.github.io/bettor-arena/contracts/knowledge-memory-proposal.v1.schema.json",
  "title": "Knowledge Memory Proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "operation",
    "scope",
    "subject",
    "memory_class",
    "content",
    "provenance",
    "retention",
    "authority"
  ],
  "properties": {
    "schema_version": {
      "const": "knowledge-memory-proposal/v1"
    },
    "proposal_id": {
      "type": "string"
    },
    "operation": {
      "enum": [
        "add",
        "supersede",
        "delete"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user",
        "project",
        "session"
      ],
      "properties": {
        "user": {
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "type": "string"
        },
        "session": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "tree"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "memory_class": {
      "enum": [
        "preference",
        "decision-pointer",
        "incident",
        "rejected-approach",
        "execution-note",
        "task-hint"
      ]
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "expires_at",
        "redaction_class"
      ],
      "properties": {
        "policy": {
          "enum": [
            "session",
            "ttl",
            "durable-human-reviewed"
          ]
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "redaction_class": {
          "enum": [
            "public",
            "internal",
            "sensitive-prohibited"
          ]
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_only",
        "auto_apply",
        "overrides_current_authority",
        "human_admit_required"
      ],
      "properties": {
        "proposal_only": {
          "const": true
        },
        "auto_apply": {
          "const": false
        },
        "overrides_current_authority": {
          "const": false
        },
        "human_admit_required": {
          "const": true
        }
      }
    }
  }
}
