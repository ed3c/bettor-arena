    "README.md",
    "docs/README.md",
    "docs/architecture/README.md",
    "docs/adr/README.md",
    "docs/audits/README.md",
    "docs/plans/README.md",
    ".arena/README.md",
    ".arena/browser/README.md",
    ".arena/compositions/README.md",
