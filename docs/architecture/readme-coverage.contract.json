    ".arena/origins/README.md",
    ".arena/presets/README.md",
    ".arena/schemas/README.md",
    "data/README.md",
    "data/browser/README.md",
    "data/context-capsules/README.md",
    "data/mcp/README.md",
    "data/migration/README.md",
    "data/module-proof/README.md",
    "data/origins/README.md",
    "data/proof-workflow/README.md",
    "data/receipts/README.md"
