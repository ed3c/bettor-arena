{
  "$defs": {
    "conflict": {
      "additionalProperties": false,
      "properties": {
        "authority": {"minLength": 1, "type": "string"},
        "id": {"pattern": "^[a-z0-9][a-z0-9._-]*$", "type": "string"},
        "state": {"enum": ["BLOCKED", "SUPERSEDED_HISTORICAL", "RESOLVED_IN_CANDIDATE", "RESOLVED"]},
        "subjects": {"items": {"minLength": 1, "type": "string"}, "minItems": 2, "type": "array", "uniqueItems": true},
        "type": {"enum": ["STALE_WRITER_LEASE", "DUPLICATE_MACHINE_AUTHORITY", "PATH_LEASE_OVERLAP", "ANCESTRY_CONFLICT"]}
      },
      "required": ["id", "type", "subjects", "state", "authority"],
      "type": "object"
    },
    "node": {
      "additionalProperties": false,
      "properties": {
        "base_branch": {"minLength": 1, "type": "string"},
        "branch": {"minLength": 1, "type": "string"},
        "evidence_ceiling": {"minLength": 1, "type": "string"},
        "head_sha": {"anyOf": [{"$ref": "#/$defs/sha40"}, {"type": "null"}]},
        "id": {"pattern": "^[a-z0-9][a-z0-9._-]*$", "type": "string"},
        "issue": {"minimum": 1, "type": ["integer", "null"]},
        "kind": {"enum": ["ISSUE_ONLY", "PULL_REQUEST"]},
        "main_presence": {"enum": ["ON_MAIN", "NOT_ON_MAIN", "NOT_APPLICABLE", "UNKNOWN"]},
        "merge_commit_sha": {"anyOf": [{"$ref": "#/$defs/sha40"}, {"type": "null"}]},
        "path_roots": {
          "items": {"minLength": 1, "not": {"pattern": "(^/|(^|/)\\.\\.(/|$))"}, "type": "string"},
          "minItems": 1,
          "type": "array"
        },
        "pr": {"minimum": 1, "type": ["integer", "null"]},
        "relation": {"enum": ["ROOT", "ROOT_AFTER_PREDECESSOR", "SIBLING", "TRUE_CHILD", "CONVERGENCE", "PROCESS_DEPENDENCY", "EXTERNAL_EVIDENCE", "HISTORICAL"]},
        "rollback_subject": {"$ref": "#/$defs/sha40"},
        "state": {"enum": ["MERGED_TO_MAIN", "OPEN", "DRAFT", "ACTIVE", "BLOCKED_BY_PREDECESSOR", "FINAL_CONVERGENCE", "PLANNED", "BRANCH_NOT_CREATED", "NOT_CREATED", "SUPERSEDED_HISTORICAL"]}
      },
      "required": ["id", "kind", "issue", "pr", "branch", "base_branch", "head_sha", "merge_commit_sha", "relation", "state", "main_presence", "path_roots", "evidence_ceiling", "rollback_subject"],
      "type": "object"
    },
    "sha40": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "stack": {
      "additionalProperties": false,
      "properties": {
        "class": {"enum": ["IMPLEMENTATION", "PROCESS", "CONTROL", "HISTORICAL", "DOCUMENTATION", "EXTERNAL_EVIDENCE"]},
        "id": {"pattern": "^[a-z0-9][a-z0-9._-]*$", "type": "string"},
        "nodes": {"items": {"$ref": "#/$defs/node"}, "minItems": 1, "type": "array"}
      },
      "required": ["id", "class", "nodes"],
      "type": "object"
    }
  },
  "$id": "https://github.com/ed3c/bettor-arena/docs/git/stack-prs.index.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority": {
      "additionalProperties": false,
      "properties": {
        "current": {"const": "GITHUB_API_AND_REPOSITORY_BYTES"},
        "refresh_on": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
        "snapshot_policy": {"const": "SNAPSHOT_ONLY"}
      },
      "required": ["current", "snapshot_policy", "refresh_on"],
      "type": "object"
    },
    "conflicts": {"items": {"$ref": "#/$defs/conflict"}, "type": "array"},
    "current_process": {
      "additionalProperties": false,
      "properties": {
        "active": {"const": "issue-172"},
        "queue_path": {"const": "docs/traceability/local-handoff-execution-queue.json"}
      },
      "required": ["active", "queue_path"],
      "type": "object"
    },
    "git_town": {
      "additionalProperties": false,
      "properties": {
        "binary_state": {"enum": ["ABSENT", "CANDIDATE", "ADMITTED"]},
        "configuration_state": {"enum": ["ABSENT", "CANDIDATE", "ADMITTED"]},
        "live_no_push_sync_state": {"enum": ["NOT_EXERCISED", "FAIL", "PASS"]},
        "method_state": {"enum": ["ABSENT", "IMPLEMENTED"]},
        "publication_state": {"enum": ["NOT_EXERCISED", "FAIL", "PASS"]},
        "semantic_conflict_state": {"enum": ["HUMAN_ADMIT_REQUIRED", "PASS", "FAIL"]}
      },
      "required": ["method_state", "binary_state", "configuration_state", "live_no_push_sync_state", "publication_state", "semantic_conflict_state"],
      "type": "object"
    },
    "observed_at": {"format": "date-time", "type": "string"},
    "program": {
      "additionalProperties": false,
      "properties": {
        "active_issue": {"const": 140},
        "active_order": {"const": 13},
        "convergence_issue": {"const": 68},
        "issue": {"const": 61}
      },
      "required": ["issue", "active_order", "active_issue", "convergence_issue"],
      "type": "object"
    },
    "repository": {
      "additionalProperties": false,
      "properties": {
        "default_branch": {"const": "main"},
        "full_name": {"const": "ed3c/bettor-arena"},
        "observed_main_sha": {"$ref": "#/$defs/sha40"},
        "observed_main_tree": {"$ref": "#/$defs/sha40"},
        "origin_issue": {"minimum": 1, "type": ["integer", "null"]},
        "origin_relation": {"enum": ["EQUIVALENT", "DIVERGED", "UNKNOWN"]},
        "repository_id": {"const": 1330387399}
      },
      "required": ["full_name", "repository_id", "default_branch", "observed_main_sha", "observed_main_tree", "origin_relation", "origin_issue"],
      "type": "object"
    },
    "schema": {"const": "bettor-arena/stack-pr-index/v3"},
    "shared_skill": {
      "additionalProperties": false,
      "properties": {
        "blob": {"$ref": "#/$defs/sha40"},
        "commit": {"$ref": "#/$defs/sha40"},
        "path": {"const": "skills/git-town-stacked-pr-worker/SKILL.md"},
        "reference_state": {"const": "PINNED"},
        "repository": {"const": "ed3c/skills-shared"},
        "selection_state": {"enum": ["NOT_SELECTED", "SELECTED"]}
      },
      "required": ["repository", "commit", "blob", "path", "reference_state", "selection_state"],
      "type": "object"
    },
    "stacks": {"items": {"$ref": "#/$defs/stack"}, "minItems": 1, "type": "array"}
  },
  "required": ["schema", "observed_at", "authority", "repository", "shared_skill", "git_town", "program", "current_process", "stacks", "conflicts"],
  "title": "Bettor Arena Stack PR index v3",
  "type": "object"
}
