#!/bin/sh
# pre-commit — staged-only fast-quality preflight (activated from
# pre-commit.staged by the admitted #14 stage 1).
set -eu
ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

if ! git diff --quiet -- .githooks scripts/gates; then
  echo "pre-commit FAIL: unstaged edits under .githooks/ or scripts/gates/ —" \
       "the gate that would run is not the gate being committed" \
       "(stage or stash those edits first)" >&2
  exit 2
fi

STAGED=$(git diff --cached --name-only --diff-filter=ACMR | while IFS= read -r path; do
  mode=$(git ls-files --stage -- "$path" | cut -c1-6)
  if [ "$mode" != "120000" ]; then printf '%s\n' "$path"; fi
done)
[ -n "$STAGED" ] || exit 0

STAGEDTREE=$(mktemp -d "${TMPDIR:-/tmp}/pre-commit.XXXXXX") || {
  echo "pre-commit: cannot create a temp dir under ${TMPDIR:-/tmp}" >&2
  exit 64
}
trap 'rm -rf "$STAGEDTREE"' EXIT
git checkout-index -a --prefix="$STAGEDTREE/tree/"

BUDGET=${FAST_QUALITY_BUDGET:-5}
set -m
( printf '%s\n' "$STAGED" | sed "s|^|$STAGEDTREE/tree/|" | sh scripts/gates/fast_quality.sh ) &
GATE=$!
( sleep "$BUDGET"; kill -- -"$GATE" 2>/dev/null ) &
DOG=$!
set +m
set +e
wait "$GATE"; RC=$?
set -e
kill -- -"$DOG" 2>/dev/null || true
wait "$DOG" 2>/dev/null || true
if [ "$RC" -ge 128 ]; then
  echo "pre-commit FATAL: fast_quality exceeded the ${BUDGET}s budget and was killed" >&2
  exit 64
fi
[ "$RC" -eq 0 ] || exit "$RC"

python3 scripts/gates/check_root_coupling.py --staged
python3 scripts/gates/check_placement.py
python3 scripts/gates/check_skill_pointers.py
python3 scripts/gates/check_credential_hygiene.py
python3 scripts/gates/check_runtime_env_binding.py --staged
python3 scripts/gates/check_delivery_receipt.py

# Modular-integration gates judge the exact staged tree. They are
# repo-contained, zero-network, and do not read sibling checkouts.
python3 "$STAGEDTREE/tree/scripts/gates/check_agent_docs.py" --root "$STAGEDTREE/tree"
python3 "$STAGEDTREE/tree/scripts/gates/check_module_catalog.py" --root "$STAGEDTREE/tree"
python3 "$STAGEDTREE/tree/scripts/arena_proof.py" --root "$STAGEDTREE/tree" check
python3 "$STAGEDTREE/tree/scripts/arena_context.py" --root "$STAGEDTREE/tree" check
python3 "$STAGEDTREE/tree/scripts/gates/check_mcp_policy.py"
command -v bun >/dev/null 2>&1 || { echo "pre-commit FATAL: bun absent" >&2; exit 64; }
bun "$STAGEDTREE/tree/scripts/gates/check_project_bootstrap.ts" --root "$STAGEDTREE/tree"
bun "$STAGEDTREE/tree/scripts/gates/check_environment_contracts.ts" --root "$STAGEDTREE/tree"
