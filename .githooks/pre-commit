#!/bin/sh
# pre-commit.staged — staged-only fast-quality preflight, STAGED (not active).
# Activation = renaming to `pre-commit`, and that is a separate human admit.
#
# What it does, in order:
#   1. Self-integrity, radius = this gate's own closure only (.githooks/ +
#      scripts/gates/): staged vs worktree must be identical there, otherwise
#      the hook/gate that is running is not the one being committed.
#   2. Materializes the staged blobs (added/copied/modified/renamed only —
#      deletions have nothing to check) into a temp tree via
#      `git checkout-index --prefix` — the gate must judge the bytes being
#      committed, never the worktree copies — and feeds those temp paths to
#      scripts/gates/fast_quality.sh, the single check definition (same source
#      as the factory sandbox's full-scope verify.sh quality:fast mount; see
#      the gate header). Relative layout is preserved under the prefix; note
#      the temp tree sits outside eslint's base path, so the hook's ts-lint
#      ride is warn-and-skip — mount 2 carries the full eslint pass.
#   3. check_root_coupling.py --staged (index blobs, not worktree).
#
# Budget: FAST_QUALITY_BUDGET seconds (default 5) wall for the gate call;
# overrun = kill + FATAL 64, never a silent pass. Runs no tests, touches no
# network. Exit: 0 pass · 2 gate FAIL · 64 FATAL (budget / missing tool).
set -eu
ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

if ! git diff --quiet -- .githooks scripts/gates; then
  echo "pre-commit FAIL: unstaged edits under .githooks/ or scripts/gates/ —" \
       "the gate that would run is not the gate being committed" \
       "(stage or stash those edits first)" >&2
  exit 2
fi

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$STAGED" ] || exit 0

STAGEDTREE=$(mktemp -d)
trap 'rm -rf "$STAGEDTREE"' EXIT
printf '%s\n' "$STAGED" | git checkout-index --prefix="$STAGEDTREE/tree/" --stdin

BUDGET=${FAST_QUALITY_BUDGET:-5}
printf '%s\n' "$STAGED" | sed "s|^|$STAGEDTREE/tree/|" | sh scripts/gates/fast_quality.sh &
GATE=$!
( sleep "$BUDGET"; kill "$GATE" 2>/dev/null ) &
DOG=$!
set +e
wait "$GATE"; RC=$?
set -e
kill "$DOG" 2>/dev/null || true
wait "$DOG" 2>/dev/null || true
if [ "$RC" -ge 128 ]; then
  echo "pre-commit FATAL: fast_quality exceeded the ${BUDGET}s budget and was killed" >&2
  exit 64
fi
[ "$RC" -eq 0 ] || exit "$RC"

# No exec: the EXIT trap must still fire to clean up the staged tree.
python3 scripts/gates/check_root_coupling.py --staged
# Repo-level structure gates (fast, read-only; §2 placement + skill pointer SSOT).
python3 scripts/gates/check_placement.py
python3 scripts/gates/check_skill_pointers.py
