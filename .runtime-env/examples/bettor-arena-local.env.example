# Generated by runtime-env. Values are placeholders, never credentials.
# optional; non-secret: Agy reasoning effort selector.
AGY_EFFORT=high
# optional; non-secret: Exact agy model id observed from the live model inventory.
AGY_MODEL=gemini-3.6-flash-high
# optional; non-secret: Explicit local path to the Antigravity source peer used by proof controls.
ANTIGRAVITY_PEER=
# required; non-secret: Dedicated Claude Code configuration root; its contents remain host-only.
CLAUDE_CONFIG_DIR=
# required; non-secret: Dedicated Codex configuration root; its contents remain host-only.
CODEX_HOME=
# optional; non-secret: Loopback CDP endpoint for an already-running dedicated research browser.
DR_CDP_URL=http://127.0.0.1:9333
# optional; non-secret: Whether broker-owned deep-research browser operations use a visible window.
DR_HEADED=0
# required; non-secret: Path to a per-request external-transmission approval receipt; the receipt contains no credential values.
EQUIVALENCE_APPROVAL_RECEIPT_PATH=
# required; non-secret: Path to the digest-bound technical-equivalence request approved for execution.
EQUIVALENCE_REQUEST_PATH=
# required; non-secret: Broker-owned file sink for technical-equivalence prompts, reports, and receipts.
EQUIVALENCE_RUN_ROOT=
# optional; non-secret: Explicit local path to the skill-bettor target peer used by proof controls.
SKILL_BETTOR_PEER=
# optional; non-secret: Additional broker-approved output roots for stealth-browser file sinks.
STEALTH_BROWSER_EXTRA_ALLOW=
# required; non-secret: Absolute path to the separately versioned stealth-browser checkout.
STEALTH_BROWSER_ROOT=
# optional; non-secret: Broker-owned path for sanitized stealth-browser diagnostics.
STEALTH_DEBUG_LOG=
# optional; non-secret: Stable browser language list used by the stealth fingerprint layer.
STEALTH_LANGUAGES=
# optional; non-secret: Explicit browser user-agent override for deterministic probes.
STEALTH_USER_AGENT=
