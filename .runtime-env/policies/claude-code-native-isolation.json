{
  "binding": "bettor-arena-local",
  "content_sha256": "5c29604c2ecd3d287c4e29ccca4986de457df64d9e8c7fe162a4b1cf1959dd06",
  "policy": {
    "carrier": "claude-code",
    "config_home_env": "CLAUDE_CONFIG_DIR",
    "external_requirements": [
      "Render placeholders to absolute host paths and install the resulting deny rules in a host or managed settings layer that the repository cannot widen."
    ],
    "forbidden_environment": [
      "CODEX_ACCESS_TOKEN",
      "CODEX_API_KEY",
      "CODEX_HOME",
      "OPENAI_API_KEY"
    ],
    "id": "claude-code-native-isolation",
    "receipt_commands": [
      "claude auth status",
      "claude --settings <rendered-settings> --permission-mode acceptEdits"
    ],
    "required_settings": {
      "permissions.defaultMode": "acceptEdits",
      "permissions.deny": [
        "Read(<runtime-env-root>/.env)",
        "Edit(<runtime-env-root>/.env)",
        "Read(<claude-config-dir>/**)",
        "Edit(<claude-config-dir>/**)",
        "Read(<codex-home>/**)",
        "Edit(<codex-home>/**)",
        "Read(<agy-home>/**)",
        "Edit(<agy-home>/**)",
        "Read(<stealth-profile-root>/**)",
        "Edit(<stealth-profile-root>/**)",
        "Read(<appstoreconnect-private-keys>/**)",
        "Edit(<appstoreconnect-private-keys>/**)"
      ],
      "permissions.disableBypassPermissionsMode": "disable",
      "sandbox.allowUnsandboxedCommands": false,
      "sandbox.enabled": true,
      "sandbox.failIfUnavailable": true,
      "sandbox.filesystem.denyRead": [
        "<runtime-env-root>/.env",
        "<claude-config-dir>",
        "<codex-home>",
        "<agy-home>",
        "<stealth-profile-root>",
        "<appstoreconnect-private-keys>"
      ],
      "sandbox.filesystem.denyWrite": [
        "<runtime-env-root>/.env",
        "<claude-config-dir>",
        "<codex-home>",
        "<agy-home>",
        "<stealth-profile-root>",
        "<appstoreconnect-private-keys>"
      ]
    },
    "schema": "runtime-env/carrier-policy/v1",
    "settings_file": "settings.json",
    "summary": "Claude Code native permission and sandbox controls without Codex state inheritance."
  },
  "schema": "runtime-env/consumer-policy/v1",
  "source": {
    "commit": "09c2277911cae5eb7e55f67921b5cdef80fd9a53",
    "repository": "https://github.com/ed3c/runtime-env",
    "tree": "28c3c577f28ca987ac2f2cea410ccda2d388dcce"
  }
}
