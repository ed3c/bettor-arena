{
  "schema": "bettor-arena/module/v1",
  "id": "knowledge-providers",
  "interface_version": "1.4.0",
  "summary": "Subject-bound provider contracts, complete paired evaluations, isolated live canaries, exact-subject on-demand activation, and proposal-only project memory governance.",
  "roots": [
    "docs/knowledge-providers",
    "scripts/check_knowledge_providers.py",
    "scripts/evaluate_knowledge_providers.py",
    "scripts/check_knowledge_provider_module.py",
    "scripts/knowledge_provider_eval_common.py",
    "scripts/knowledge_provider_eval_contracts.py",
    "scripts/knowledge_provider_eval_registry.py",
    "scripts/knowledge_provider_eval_cases.py",
    "scripts/knowledge_provider_eval_packet.py",
    "scripts/knowledge_provider_eval_metrics.py",
    "scripts/knowledge_provider_eval_engine.py",
    "scripts/knowledge_provider_eval_selftest.py",
    "scripts/providers/provider_canary_common.py",
    "scripts/providers/serena_canary.py",
    "scripts/providers/grepai_canary.py",
    "scripts/providers/provider_activation.py",
    "data/provider-canaries",
    "data/provider-configurations",
    "data/provider-activations"
  ],
  "components": {
    "contracts": {
      "required": true,
      "paths": [
        "docs/knowledge-providers/contracts"
      ]
    },
    "registry": {
      "required": true,
      "paths": [
        "docs/knowledge-providers/registry.json",
        "docs/knowledge-providers/providers"
      ]
    },
    "eval_contracts": {
      "required": true,
      "paths": [
        "docs/knowledge-providers/evals/config.json",
        "docs/knowledge-providers/evals/subject.json",
        "docs/knowledge-providers/evals/contracts"
      ]
    },
    "evals": {
      "required": true,
      "paths": [
        "docs/knowledge-providers/evals/participants",
        "docs/knowledge-providers/evals/cases",
        "docs/knowledge-providers/evals/fixtures",
        "scripts/evaluate_knowledge_providers.py",
        "scripts/knowledge_provider_eval_common.py",
        "scripts/knowledge_provider_eval_contracts.py",
        "scripts/knowledge_provider_eval_registry.py",
        "scripts/knowledge_provider_eval_cases.py",
        "scripts/knowledge_provider_eval_packet.py",
        "scripts/knowledge_provider_eval_metrics.py",
        "scripts/knowledge_provider_eval_engine.py",
        "scripts/knowledge_provider_eval_selftest.py"
      ]
    },
    "proof": {
      "required": true,
      "paths": [
        "scripts/check_knowledge_providers.py",
        "scripts/check_knowledge_provider_module.py",
        "scripts/providers/provider_canary_common.py",
        "scripts/providers/serena_canary.py",
        "scripts/providers/grepai_canary.py",
        "scripts/providers/provider_activation.py"
      ]
    }
  },
  "provides": [
    "knowledge-provider.query/v1",
    "knowledge-provider.memory-proposal/v1",
    "knowledge-provider.eval/v1",
    "knowledge-provider.live-canary/v1",
    "knowledge-provider.activation/v1"
  ],
  "requires": [
    "arena.module-catalog/v1",
    "arena.proof-kernel/v1"
  ],
  "conflicts": [],
  "skills": {
    "required": [
      "repo-agent-native"
    ],
    "optional": [],
    "repo_owned": []
  },
  "runtime": {
    "profiles": [],
    "tools": [
      "python3",
      "sh"
    ]
  },
  "loops": [
    {
      "id": "knowledge-providers",
      "class": "provider",
      "interface_version": "1.0.0",
      "public_port": "python3 scripts/check_knowledge_providers.py",
      "external_policy": "denied"
    },
    {
      "id": "knowledge-provider-evals",
      "class": "provider",
      "interface_version": "1.1.0",
      "public_port": "python3 scripts/evaluate_knowledge_providers.py",
      "external_policy": "denied"
    },
    {
      "id": "knowledge-provider-activation",
      "class": "provider",
      "interface_version": "1.0.0",
      "public_port": "python3 scripts/providers/provider_activation.py",
      "external_policy": "denied"
    }
  ],
  "external_policy": {
    "exposed": false,
    "mutation": "none",
    "network": "none",
    "secrets": "none"
  },
  "proof": {
    "verify": [
      "python3",
      "scripts/check_knowledge_provider_module.py"
    ],
    "selftest": [
      "python3",
      "scripts/check_knowledge_provider_module.py",
      "--selftest"
    ],
    "control": [
      "sh",
      "tests/knowledge-provider-evals/run-all.sh"
    ],
    "mutation": [
      "python3",
      "scripts/evaluate_knowledge_providers.py",
      "--selftest"
    ]
  }
}
