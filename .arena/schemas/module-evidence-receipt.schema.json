{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/bettor-arena/.arena/schemas/module-evidence-receipt.schema.json",
  "title": "Bettor Arena Module Evidence Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "module", "interface_version", "closure_sha256", "kind", "status", "command", "exit", "evidence_sha256", "note"],
  "properties": {
    "schema": {"const": "bettor-arena/module-evidence-receipt/v1"},
    "module": {"type": "string", "minLength": 1},
    "interface_version": {"type": "string", "minLength": 1},
    "closure_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "kind": {"enum": ["proof", "control", "mutation"]},
    "status": {"enum": ["PASS", "FAIL", "ABSENT", "NOT_EXERCISED"]},
    "command": {"type": "array", "items": {"type": "string"}},
    "exit": {"type": ["integer", "null"]},
    "evidence_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "note": {"type": "string"}
  }
}
