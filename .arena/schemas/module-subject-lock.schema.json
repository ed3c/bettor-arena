{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/bettor-arena/.arena/schemas/module-subject-lock.schema.json",
  "title": "Bettor Arena Module Subject Lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "composition", "composition_lock_sha256", "modules", "content_sha256"],
  "properties": {
    "schema": {"const": "bettor-arena/module-subject-lock/v1"},
    "composition": {"type": "string", "minLength": 1},
    "composition_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "interface_version", "owned_files", "files_sha256", "manifest_sha256", "proof_spec_sha256", "skills", "runtime", "local_sha256", "dependencies", "closure_sha256"],
        "properties": {
          "id": {"type": "string"},
          "interface_version": {"type": "string"},
          "owned_files": {"type": "integer", "minimum": 1},
          "files_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "proof_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "local_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "closure_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "skills": {"type": "array"},
          "runtime": {"type": "object"},
          "dependencies": {"type": "array"}
        }
      }
    }
  }
}
