{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/bettor-arena/.arena/schemas/ownership-classes.schema.json",
  "title": "Bettor Arena Ownership Classes v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "classes"],
  "properties": {
    "schema": {
      "const": "bettor-arena/ownership-classes/v1"
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "description", "paths"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9._-]+$"
          },
          "kind": {
            "enum": ["generated", "evidence", "documentation", "metadata"]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
