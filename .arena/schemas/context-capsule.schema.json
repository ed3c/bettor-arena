{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/bettor-arena/.arena/schemas/context-capsule.schema.json",
  "title": "Bettor Arena Context Capsule v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "module", "loop", "cwd", "common", "drivers", "policy"],
  "properties": {
    "schema": {"const": "bettor-arena/context-capsule/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
    "module": {"type": "string", "minLength": 1},
    "loop": {"type": "string", "minLength": 1},
    "cwd": {"type": "string", "minLength": 1},
    "common": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "drivers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claude-code", "codex-cli"],
      "properties": {
        "claude-code": {"$ref": "#/$defs/driver"},
        "codex-cli": {"$ref": "#/$defs/driver"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immutable_ref_required", "mutation", "network", "secrets", "max_seconds"],
      "properties": {
        "immutable_ref_required": {"const": true},
        "mutation": {"const": "none"},
        "network": {"enum": ["none", "host-policy"]},
        "secrets": {"enum": ["none", "host-only"]},
        "max_seconds": {"type": "integer", "minimum": 1, "maximum": 900}
      }
    }
  },
  "$defs": {
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "binary"],
      "properties": {
        "entry": {"type": "string", "minLength": 1},
        "binary": {"enum": ["claude", "codex"]}
      }
    }
  }
}
