{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/bettor-arena/.arena/schemas/origin-contract.schema.json",
  "title": "Bettor Arena Logical Source Origin Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "logical_source", "release_manifest", "accepted_equivalence", "origins"],
  "properties": {
    "schema": {"const": "bettor-arena/origin-contract/v1"},
    "logical_source": {"type": "string", "minLength": 1},
    "release_manifest": {"type": "string", "minLength": 1},
    "accepted_equivalence": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["exact-commit", "same-tree", "same-release-manifest"]}
    },
    "origins": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "scopes", "repository", "live_probe"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "role": {"enum": ["authoring", "distribution"]},
          "scopes": {"type": "array", "uniqueItems": true, "items": {"enum": ["local", "cloud", "promotion"]}},
          "repository": {"type": "string", "minLength": 1},
          "live_probe": {"enum": ["ci", "host-only"]}
        }
      }
    }
  }
}
