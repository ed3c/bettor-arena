{
  "schema": "bettor-arena/context-capsule/v1",
  "id": "openwiki",
  "module": "openwiki",
  "loop": "openwiki",
  "cwd": "kb-ingest",
  "common": [
    "AGENTS.md",
    "CLAUDE.md",
    "ARCHITECTURE.md",
    "kb-ingest/README.md",
    "kb-ingest/skill/SKILL.md",
    "kb-ingest/port/README.md",
    "docs/architecture/modular-integration-requirements.md"
  ],
  "drivers": {
    "claude-code": {"entry": "CLAUDE.md", "binary": "claude"},
    "codex-cli": {"entry": "AGENTS.md", "binary": "codex"}
  },
  "policy": {
    "immutable_ref_required": true,
    "mutation": "none",
    "network": "host-policy",
    "secrets": "host-only",
    "max_seconds": 180
  }
}
