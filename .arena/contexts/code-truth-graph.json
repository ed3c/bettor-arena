  "loop": "ctg",
  "cwd": "loop_wiki/code-truth-graph",
  "common": [
    "AGENTS.md",
    "CLAUDE.md",
    "ARCHITECTURE.md",
    "loop_wiki/code-truth-graph/AGENTS.md",
    "loop_wiki/code-truth-graph/CLAUDE.md",
    "loop_wiki/code-truth-graph/PROMPT.md",
    "loop_wiki/code-truth-graph/ROUTES.md",
    "loop_wiki/code-truth-graph/PLAN.md",
