{
  "schema": "bettor-arena/context-capsule/v1",
  "id": "macro",
  "module": "arena-core",
  "loop": "macro",
  "cwd": ".",
  "common": [
    "AGENTS.md",
    "CLAUDE.md",
    "ARCHITECTURE.md",
    "CONTEXT.md",
    "docs/architecture/PDF_HARNESS_INTEGRATION_AUDIT.md",
    "docs/architecture/pdf-harness-integration.matrix.json",
    "docs/architecture/DIRECTORY_STATE_MACHINE_MAP.md",
    "docs/architecture/modular-integration-requirements.md",
    "docs/architecture/modular-integration-status.md",
    "docs/architecture/STATE_MACHINES.md",
    "docs/integration/CROSS_REPO_INTEGRATION.md",
    "docs/architecture/PDF_LOOPX_HARNESS_TRACEABILITY.md",
    "docs/architecture/pdf-loopx-harness.integration.json",
    "docs/traceability/STACK_PR_INDEX.md",
    "docs/agent-runtime-integration.md"
  ],
  "drivers": {
    "claude-code": {
      "entry": "CLAUDE.md",
      "binary": "claude"
    },
    "codex-cli": {
      "entry": "AGENTS.md",
      "binary": "codex"
    }
  },
  "policy": {
    "immutable_ref_required": true,
    "mutation": "none",
    "network": "host-policy",
    "secrets": "host-only",
    "max_seconds": 180
  }
}
