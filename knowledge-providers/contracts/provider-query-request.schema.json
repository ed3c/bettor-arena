{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ed3c.github.io/bettor-arena/contracts/knowledge-provider-query-request.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "subject", "provider", "index", "capability", "effect_mode", "query", "query_digest"],
  "properties": {
    "schema_version": {"const": "knowledge-provider-query-request/v1"},
    "request_id": {"type": "string"},
    "subject": {"type": "object"},
    "provider": {"type": "object"},
    "index": {"type": "object"},
    "capability": {"type": "string"},
    "effect_mode": {"enum": ["READ_ONLY", "PROPOSAL_ONLY"]},
    "query": {"type": "object"},
    "query_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
