{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ed3c.github.io/bettor-arena/contracts/knowledge-provider-query-receipt.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "subject", "provider", "index", "capability", "query_digest", "status", "evidence_mode", "results", "result_count", "authority", "source_readback_required", "canary_artifacts", "generated_at"],
  "properties": {
    "schema_version": {"const": "knowledge-provider-query-receipt/v1"},
    "request_id": {"type": "string"},
    "subject": {"type": "object"},
    "provider": {"type": "object"},
    "index": {"type": "object"},
    "capability": {"type": "string"},
    "query_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {"enum": ["CANDIDATE", "STALE_INDEX", "SUBJECT_MISMATCH", "PROVIDER_UNAVAILABLE", "ERROR", "NOT_EXERCISED"]},
    "evidence_mode": {"enum": ["synthetic-fixture", "live-canary"]},
    "results": {"type": "array"},
    "result_count": {"type": "integer", "minimum": 0},
    "authority": {"type": "object"},
    "source_readback_required": {"const": true},
    "canary_artifacts": {"type": "array"},
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
