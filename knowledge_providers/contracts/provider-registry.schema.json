{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ed3c/bettor-arena/knowledge_providers/contracts/provider-registry.schema.json",
  "title": "Knowledge Provider Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority_model",
    "providers"
  ],
  "properties": {
    "schema_version": {
      "const": "knowledge-provider-registry/v1"
    },
    "authority_model": {
      "const": "projection-only"
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "display_name",
          "role",
          "upstream",
          "transport_candidates",
          "capabilities",
          "forbidden_operations",
          "authority",
          "projection",
          "admission"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "symbolic",
              "semantic",
              "graph",
              "episodic"
            ]
          },
          "upstream": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository",
              "license",
              "source_ref",
              "source_digest",
              "evidence_urls"
            ],
            "properties": {
              "repository": {
                "type": "string",
                "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:\\.git)?$"
              },
              "license": {
                "type": "string",
                "minLength": 1
              },
              "source_ref": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "source_digest": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "evidence_urls": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^https://github\\.com/"
                }
              }
            }
          },
          "transport_candidates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "mcp",
                "cli",
                "http",
                "library"
              ]
            }
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "index.status",
                "symbol.lookup",
                "symbol.references",
                "symbol.rename_plan",
                "search.semantic",
                "callgraph.trace",
                "graph.neighbors",
                "graph.path",
                "graph.impact",
                "structural.search",
                "memory.recall",
                "memory.write_proposal",
                "memory.delete_proposal"
              ]
            }
          },
          "forbidden_operations": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "authority": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code_mutation",
              "memory_mutation",
              "loopx_state_write",
              "gate_verdict",
              "promotion",
              "human_admit"
            ],
            "properties": {
              "code_mutation": {
                "type": "string",
                "enum": [
                  "denied"
                ]
              },
              "memory_mutation": {
                "type": "string",
                "enum": [
                  "denied",
                  "proposal-only"
                ]
              },
              "loopx_state_write": {
                "const": false
              },
              "gate_verdict": {
                "const": false
              },
              "promotion": {
                "const": false
              },
              "human_admit": {
                "const": false
              }
            }
          },
          "projection": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "canonical",
              "rebuildable",
              "subject_binding",
              "staleness_check",
              "index_kind"
            ],
            "properties": {
              "canonical": {
                "const": false
              },
              "rebuildable": {
                "const": true
              },
              "subject_binding": {
                "const": "exact-commit-tree"
              },
              "staleness_check": {
                "const": "required"
              },
              "index_kind": {
                "type": "string",
                "enum": [
                  "lsp-workspace",
                  "vector-index",
                  "code-graph",
                  "memory-index"
                ]
              }
            }
          },
          "admission": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "execution_status",
              "notes"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "CANDIDATE",
                  "BOUND",
                  "TESTED",
                  "REJECTED"
                ]
              },
              "execution_status": {
                "type": "string",
                "enum": [
                  "NOT_EXERCISED",
                  "PASS",
                  "FAIL",
                  "ABSENT",
                  "SKIPPED_BY_POLICY"
                ]
              },
              "notes": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
